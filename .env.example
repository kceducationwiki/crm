# Chuỗi kết nối PostgreSQL (trên Dokploy: lấy "Internal Connection URL" của database)
DATABASE_URL=postgresql://kccrm:matkhau@localhost:5432/kccrm

# (Tuỳ chọn) Cổng chạy server, mặc định 3000
PORT=3000

# (Tuỳ chọn) Khoá ký phiên đăng nhập. Bỏ trống = tự sinh và lưu trong database.
# SESSION_SECRET=

# (Nên đặt khi đưa lên mạng) Mã đăng ký nội bộ: ai muốn tạo tài khoản phải nhập đúng mã này.
# Bỏ trống = ai có link cũng đăng ký được (vẫn phải chờ quản lý duyệt mới xem được dữ liệu).
# SIGNUP_CODE=kc-2026-noibo

# (Tuỳ chọn) Bật nếu database yêu cầu SSL (database bên ngoài). Dokploy nội bộ thì KHÔNG cần.
# DATABASE_SSL=true

# ---------------------------------------------------------------------
# (Tuỳ chọn) THÔNG BÁO NHẮC VIỆC — follow-up đến hạn, công nợ / hoá đơn / giấy tờ sau ngày chốt
# Bỏ trống hết = không gửi. Có thể dùng email, Zalo, hoặc cả hai.
# ---------------------------------------------------------------------
# Địa chỉ web (để link trong tin nhắc + để Zalo gửi tin về). Trên Dokploy: https://crm.kcedu.vn
# APP_URL=https://crm.kcedu.vn

# Email qua SMTP. Ví dụ Gmail / Google Workspace: tạo "Mật khẩu ứng dụng" (App password) rồi điền:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=crm@kcedu.vn
# SMTP_PASS=abcdabcdabcdabcd
# SMTP_FROM=KC CRM <crm@kcedu.vn>

# Zalo Bot: tạo bot tại https://bot.zaloplatforms.com rồi dán Bot Token
# ZALO_BOT_TOKEN=1234567890:xxxxxxxxxxxxxxxx
